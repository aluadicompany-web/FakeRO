# Never put real passwords in Git. Copy to .env on your server.
PUBLIC_ORIGIN=http://localhost:3000
# Used by the optional HTTPS proxy. Set to a domain pointing to your VM.
PUBLIC_HOST=
BIND_ADDRESS=127.0.0.1
GM_USERNAME=worldkeeper
# Required for first-time GM bootstrap. Use the private generated password or a new strong value.
GM_PASSWORD=
